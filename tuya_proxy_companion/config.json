{
  "name": "Tuya Proxy Companion",
  "description": "MQTT MITM proxy for Tuya-based cameras. Intercepts cloud traffic and routes motion events locally to Frigate — no SmartLife required.",
  "version": "0.3.3",
  "slug": "tuya_proxy_companion",
  "url": "https://github.com/felipearmat/tuya-proxy-companion",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "host_network": true,
  "homeassistant_api": true,
  "privileged": ["NET_ADMIN", "NET_RAW", "SYS_ADMIN"],
  "options": {
    "proxy_port": 18883,
    "camera_mqtt_port": 8883,
    "api_port": 8765,
    "log_level": "info"
  },
  "schema": {
    "proxy_port": "int",
    "camera_mqtt_port": "int",
    "api_port": "int",
    "log_level": "list(debug|info|warning|error)"
  }
}
